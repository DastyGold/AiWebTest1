# Порт для сервера
PORT=5000

# Учетные данные для GigaChat API
# Получите учетные данные в личном кабинете разработчика Сбер: https://developers.sber.ru/
GIGACHAT_CLIENT_ID=your_client_id_here
GIGACHAT_CLIENT_SECRET=your_client_secret_here

# Настройки CORS (необязательно)
# Список разрешенных доменов через запятую
ALLOWED_ORIGINS=http://localhost:5000,http://localhost:3000,https://sergeogold.com

# Учетные данные для доступа к панели администратора
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_secure_password

# Настройки базы данных (если будет использоваться)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=sergeogold
# DB_USER=admin
# DB_PASSWORD=password

# Настройки почты (если будет использоваться)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password